// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // Prisma uses 'mysql' provider for both MySQL and MariaDB
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  passwordHash     String
  name             String
  phone            String?
  role             String    @default("CUSTOMER")
  resetCode        String?
  resetCodeExpires DateTime?
  orders           Order[] // ADMIN or CUSTOMER
  createdAt        DateTime  @default(now())
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  type      String // "PRODUCT" or "TUTORIAL"
  products  Product[]
  tutorials Tutorial[]

  @@unique([name, type])
}

model Product {
  id               Int         @id @default(autoincrement())
  name             String
  description      String?     @db.Text
  price            Float
  stock            Int         @default(0)
  image            String?     @db.Text // Primary image
  images           String?     @db.Text // JSON array of additional gallery image URLs
  category         Category    @relation(fields: [categoryId], references: [id])
  categoryId       Int
  rating           Float       @default(5.0)
  allowCustomText  Boolean     @default(true)
  bulkDiscountPct  Int         @default(20)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  OrderItem        OrderItem[]
}

model Tutorial {
  id          Int         @id @default(autoincrement())
  title       String
  description String?     @db.Text
  price       Float       @default(0)
  isFree      Boolean     @default(false)
  videoUrl    String?
  image       String?
  level       String? // Beginner | Intermediate | Advanced
  type        String? // Video | Text & Images
  duration    String?
  materials   String?     @db.Text // JSON array
  steps       String?     @db.Text // JSON array
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  OrderItem   OrderItem[]
}

model JournalPost {
  id          Int      @id @default(autoincrement())
  title       String
  lead        String?  @db.Text
  body        String?  @db.Text
  image       String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Order {
  id                   Int         @id @default(autoincrement())
  userId               Int?
  user                 User?       @relation(fields: [userId], references: [id])
  customerName         String
  customerEmail        String
  customerPhone        String?
  shippingAddress      String?     @db.Text
  shippingCity         String?
  shippingState        String?
  shippingPincode      String?
  totalAmount          Float
  status               String      @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, PAID, SHIPPED, DELIVERED
  paymentScreenshotUrl String?
  items                OrderItem[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  Int?
  product    Product?  @relation(fields: [productId], references: [id])
  tutorialId Int?
  tutorial   Tutorial? @relation(fields: [tutorialId], references: [id])
  quantity   Int       @default(1)
  price      Float
}

model HeroImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  side      String // "LEFT" | "RIGHT"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model HomePageContent {
  id               Int      @id @default(autoincrement())
  heroTitle        String   @default("Something special is on the way.")
  heroTitleSpan    String   @default("on the way.")
  heroDescription  String   @db.Text
  heroPrimaryBtn   String   @default("Explore shop")
  heroPrimaryLink  String   @default("/shop")
  heroSecondaryBtn String   @default("Chat on WhatsApp")
  whatsappMessage  String?  @db.Text
  customTitle      String   @default("Made for your moment")
  customDesc       String   @db.Text
  customBtnText    String   @default("Request a custom order")
  closingTitle     String   @default("Find a piece that feels like you.")
  closingDesc      String   @default("Browse the shop, or start a custom conversation.")
  featuredProductIds  String?  @db.Text // JSON array of selected product IDs
  featuredTutorialIds String?  @db.Text // JSON array of selected tutorial IDs
  featuredJournalIds  String?  @db.Text // JSON array of selected journal IDs
  updatedAt        DateTime @updatedAt
}

model CustomRequest {
  id               Int      @id @default(autoincrement())
  requestId        String   @unique // e.g. REQ-1001
  customerName     String
  customerEmail    String
  customerPhone    String?
  orderVolume      String   @default("single") // "single" | "bulk"
  quantity         Int      @default(1)
  description      String   @db.Text
  deadline         String?
  budget           String?  // null initially unless admin quotes or customer specified
  quotedAmount     Float?   // Admin confirmed final quote in Rs
  adminNotes       String?  @db.Text
  paymentProofUrl  String?  // Admin uploaded screenshot of customer payment
  invoiceNumber    String?  // e.g. INV-REQ1001
  invoiceSentAt    DateTime?
  status           String   @default("Pending") // "Pending" | "Quoted" | "Paid" | "Declined"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

